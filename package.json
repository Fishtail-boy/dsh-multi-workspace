{
  "name": "dsh-multi-workspace",
  "version": "0.1.0",
  "description": "Add multiple project folders to one DeepSeek Harness workspace (fork of skylarking/dsh-plugin-workspace-multi, DSH 0.2.2 compatible)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fishtail-boy/dsh-multi-workspace.git"
  },
  "homepage": "https://github.com/Fishtail-boy/dsh-multi-workspace#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workspace"
  ],
  "scripts": {
    "build": "pnpm --filter dsh-multi-workspace-host run build && pnpm --filter dsh-multi-workspace-client run build && tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "desktop": {
      "supportPackages": {
        "dsh-multi-workspace-client": "./packages/client",
        "dsh-multi-workspace-host": "./packages/host"
      }
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dependencies": {
    "dsh-multi-workspace-client": "workspace:^",
    "dsh-multi-workspace-host": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-directory-picker-native": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-host-directory-picker-native": "0.2.2-rc.1",
    "@types/node": "^22.20.1",
    "lightningcss": "^1.33.0",
    "rolldown": "1.2.16",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
